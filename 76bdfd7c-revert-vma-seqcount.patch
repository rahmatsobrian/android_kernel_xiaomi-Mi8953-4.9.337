 9 files changed, 47 insertions(+), 93 deletions(-)

diff --git fs/proc/task_mmu.c fs/proc/task_mmu.c
index 7c1aae377b7e..e801cd996081 100644
--- fs/proc/task_mmu.c
+++ fs/proc/task_mmu.c
@@ -1223,11 +1223,8 @@ static ssize_t clear_refs_write(struct file *file, const char __user *buf,
 					goto out_mm;
 				}
 				for (vma = mm->mmap; vma; vma = vma->vm_next) {
-					vm_write_begin(vma);
-					WRITE_ONCE(vma->vm_flags,
-						vma->vm_flags & ~VM_SOFTDIRTY);
+					vma->vm_flags &= ~VM_SOFTDIRTY;
 					vma_set_page_prot(vma);
-					vm_write_end(vma);
 				}
 				downgrade_write(&mm->mmap_sem);
 				break;
